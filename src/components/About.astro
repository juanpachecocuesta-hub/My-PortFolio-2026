---
import { Image } from "astro:assets";
import Designer from "../assets/Designer.png";
---

<section class="section-about">
  <div class="about-container">
    <div class="about-part1">
      <span class="about-tittle">About Me / 01</span>

      <div class="about-name-box">
        <h1 class="about-name">Beyond the screen.</h1>
      </div>

      <p class="about-subtitle">
        I'm Juan Camilo, a curious mind passionate about programming,
        calisthenics and personal growth. I enjoy creating digital experiences,
        learning new technologies and challenging my limits every day.
      </p>

      <p class="about-subtitle part-2">
        My goal is to keep growing as a developer and athlete while turning my
        ideas into reality.
      </p>
      <div class="about-buttons">
        <button class="btn btn-primary">Development ↗</button>

        <button class="btn btn-secundary">My Lifestyle ↗</button>
      </div>
    </div>

    <div class="about-img">
      <div class="about-card">
        <span class="card-number">01</span>
        <h2>Development</h2>
        <p>
          I enjoy programming and building modern websites with clean and
          creative designs.
        </p>
        <span class="card-tag">CREATIVITY - LOGIC</span>
      </div>

      <div class="about-card">
        <span class="card-number">02</span>
        <h2>Calisthenics</h2>
        <p>
          I train strength skills like the planche, improving my discipline and
          consistency.
        </p>
        <span class="card-tag">STRENGTH - DISCIPLINE</span>
      </div>

      <div class="about-card">
        <span class="card-number">03</span>
        <h2>Mindset</h2>
        <p>
          I believe in constant improvement and learning something new every
          day.
        </p>
        <span class="card-tag">GROWTH - CONSISTENCY</span>
      </div>
    </div>
  </div>
</section>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap");

  :root {
    --bg: #171815;
    --surface: #22231f;
    --cream: #eee7d9;
    --muted: #aaa99f;
    --green: #a8b99f;
    --green2: #99af8d;
    --border: rgba(238, 231, 217, 0.14);
  }

  .section-about {
    background-color: var(--bg);
    padding: 5rem 2.5rem;
    border: 1px solid var(--green2);
    border-radius: 10px;
  }

  .about-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 4rem;
  }

  .about-part1 {
    max-width: 500px;
  }

  .about-tittle {
    font-size: 1.2rem;
    color: var(--green2);
    font-family: "DM Sans", sans-serif;
  }

  .about-name-box {
    max-width: 450px;
    margin-top: 15px;
  }

  .about-name {
    color: var(--cream);
    font-size: 4rem;
    line-height: 1;
    font-family: "Playfair Display", serif;
  }

  .about-subtitle {
    line-height: 1.6rem;
    color: var(--muted);
    font-size: 1rem;
    font-family: "DM Sans", sans-serif;
    margin-top: 25px;
  }

  .part-2 {
    margin-top: 15px;
  }

  .about-buttons {
    display: flex;
    gap: 12px;
    margin-top: 25px;
  }

  .btn {
    padding: 12px 18px;
    border-radius: 8px;
    cursor: pointer;
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
  }

  .btn-primary {
    background-color: var(--green);
    color: #171815;
    border: 1px solid var(--green);
  }

  .btn-secundary {
    background-color: transparent;
    color: var(--green);
    border: 1px solid var(--green);
  }

  .about-img {
    display: flex;
    flex-direction: column;
    gap: 15px;
    width: 430px;
  }

  .about-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 22px 25px;
    transition: 0.3s;
  }

  .about-card:hover {
    border-color: var(--green2);
    transform: translateX(-5px);
  }

  .card-number {
    color: var(--green2);
    font-size: 13px;
    font-family: "DM Sans", sans-serif;
  }

  .about-card h2 {
    color: var(--cream);
    font-family: "Playfair Display", serif;
    font-size: 1.7rem;
    margin: 10px 0;
  }

  .about-card p {
    color: var(--muted);
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 1.5rem;
  }

  .card-tag {
    display: block;
    color: var(--green2);
    font-size: 10px;
    letter-spacing: 1.5px;
    margin-top: 15px;
  }
</style>
